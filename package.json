{
  "name": "lazydiff",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "types": {
        "@nubjs/types": "^0.6.0",
        "@types/node": "^26.1.2"
      }
    },
    "catalog": {
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run quality",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fix": "turbo run quality:fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix ."
  },
  "devDependencies": {
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "nub@0.6.0"
}
