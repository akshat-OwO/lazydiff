{
  "name": "lazydiff-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "types": {
        "@nubjs/types": "^0.6.0",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4"
      },
      "effect": {
        "effect": "^4.0.0-beta.102",
        "@effect/platform-node": "^4.0.0-beta.102"
      }
    },
    "catalog": {
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run quality",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "dev": "turbo run dev",
    "fix": "turbo run quality:fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "turbo run test",
    "version": "changeset version && nub install --lockfile-only",
    "doctor": "nub dlx react-doctor@latest"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "npm": "^11.19.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "nub@0.6.0"
}
